// ! AUTO-GENERATED by the shell settings app — do not edit, changes will be overwritten

layout {
    gaps 3
    center-focused-column "on-overflow"
    default-column-width { proportion 0.5; }
    border {
        on
        width 1
    }
    focus-ring {
        on
        width 2
    }
    shadow {
        off
        softness 30
        spread 5
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.2
}

input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 600
        repeat-rate 25
    }
    touchpad {
        tap
        natural-scroll
        scroll-factor 1
        accel-speed 0
    }
    mouse {
        accel-speed 0
    }
    focus-follows-mouse
}

animations {
    slowdown 1
}

cursor {
    xcursor-size 24
}
